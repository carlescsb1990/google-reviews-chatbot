# Google My Business API Configuration
# Apply for access at: https://docs.google.com/forms/d/e/1FAIpQLSfC_FKSWzbSae_5rOpgwFeIUzXUF1JCQnlsZM_gC1I2UHjA3w/viewform
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Redis Configuration (for Celery)
# Local Redis: redis://localhost:6379/0
# Redis Cloud: redis://username:password@host:port/db
REDIS_URL=redis://localhost:6379/0

# Flask Application Configuration
DEBUG=True
PORT=3000
HOST=0.0.0.0

# Celery Configuration
CELERY_ALWAYS_EAGER=False  # Set to True for synchronous task execution in development
