# Google My Business API Configuration
# Obtener en: https://console.cloud.google.com/
VITE_GOOGLE_API_KEY=your_google_api_key_here
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# OpenAI API Configuration
# Obtener en: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=sk-your_openai_api_key_here

# Backend URL (si tienes un backend personalizado)
VITE_BACKEND_URL=http://localhost:5000

# Configuración de la aplicación
VITE_APP_ENV=development
VITE_DEBUG=true

# Instrucciones de configuración:
# 1. Copia este archivo como .env.local
# 2. Reemplaza los valores de ejemplo con tus claves reales
# 3. Reinicia el servidor de desarrollo (npm run dev)
# 4. Ve a /reviews para probar la configuración

# Para obtener las claves de Google:
# 1. Ve a https://console.cloud.google.com/
# 2. Crea un nuevo proyecto o selecciona uno existente
# 3. Habilita la API de Google My Business
# 4. Crea credenciales (OAuth 2.0 Client ID)
# 5. Solicita acceso en: https://docs.google.com/forms/d/e/1FAIpQLSfC_FKSWzbSae_5rOpgwFeIUzXUF1JCQnlsZM_gC1I2UHjA3w/viewform

# Para obtener la clave de OpenAI:
# 1. Ve a https://platform.openai.com/
# 2. Crea una cuenta o inicia sesión
# 3. Ve a API Keys y crea una nueva clave
# 4. Configura el método de pago si es necesario
