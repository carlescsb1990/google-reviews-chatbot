# ===========================================
# CONFIGURACIÓN DE APIS REALES - SIN MOCKUPS
# ===========================================
# Este archivo contiene todas las variables de entorno necesarias
# para una implementación completa sin simulaciones

# ========================================
# GOOGLE MY BUSINESS API (OBLIGATORIO)
# ========================================
# Obtener desde: https://console.cloud.google.com/apis/credentials

# API Key para Google My Business
VITE_GOOGLE_API_KEY=your_google_api_key_here

# OAuth 2.0 Client ID (OBLIGATORIO para autenticación)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# OAuth 2.0 Client Secret (OBLIGATORIO para flujo completo)
VITE_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ========================================
# OPENAI API (OBLIGATORIO)
# ========================================
# Obtener desde: https://platform.openai.com/api-keys

# API Key de OpenAI para respuestas de IA
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Modelo de OpenAI a usar (opcional, por defecto: gpt-3.5-turbo)
VITE_OPENAI_MODEL=gpt-3.5-turbo

# ========================================
# BACKEND FLASK/PYTHON (OPCIONAL)
# ========================================
# Para funcionalidades avanzadas como análisis y Celery

# URL del servidor Flask backend
VITE_BACKEND_URL=http://localhost:5000

# Puerto del servidor Flask (para desarrollo)
FLASK_PORT=5000

# ========================================
# REDIS CONFIGURATION (OPCIONAL)
# ========================================
# Para Celery y tareas programadas

# URL de conexión a Redis
VITE_REDIS_URL=redis://localhost:6379/0

# URL para el broker de Celery
CELERY_BROKER_URL=redis://localhost:6379/0

# URL para el backend de resultados de Celery
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ========================================
# CONFIGURACIÓN DE PRODUCCIÓN (OPCIONAL)
# ========================================

# URL base para producción
VITE_PRODUCTION_URL=https://your-domain.com

# Clave secreta para JWT (si se implementa autenticaci��n)
JWT_SECRET_KEY=your-super-secret-jwt-key-here

# Modo de desarrollo/producción
NODE_ENV=development

# ========================================
# CONFIGURACIÓN DE ANALÍTICAS (OPCIONAL)
# ========================================

# Google Analytics ID (opcional)
VITE_GA_TRACKING_ID=GA-XXXX-XXXX

# Sentry DSN para monitoreo de errores (opcional)
VITE_SENTRY_DSN=your_sentry_dsn_here

# ========================================
# CONFIGURACIÓN AVANZADA (OPCIONAL)
# ========================================

# Límite de rate para APIs (requests por minuto)
API_RATE_LIMIT=60

# Timeout para requests HTTP (en milisegundos)
HTTP_TIMEOUT=30000

# Número máximo de reseñas a obtener por request
MAX_REVIEWS_PER_REQUEST=50

# ========================================
# INSTRUCCIONES DE CONFIGURACIÓN
# ========================================

# 1. GOOGLE MY BUSINESS API:
#    - Ir a https://console.cloud.google.com/
#    - Crear nuevo proyecto o seleccionar existente
#    - Habilitar "Google My Business API"
#    - Crear credenciales (API Key + OAuth 2.0)
#    - Configurar URL de redirección: http://localhost:5173/auth/callback

# 2. OPENAI API:
#    - Ir a https://platform.openai.com/api-keys
#    - Crear nueva API key
#    - Copiar la clave generada

# 3. BACKEND FLASK (OPCIONAL):
#    - Instalar Redis: brew install redis (macOS) o apt install redis (Ubuntu)
#    - Ejecutar: redis-server
#    - Instalar dependencias Python: pip install -r requirements.txt
#    - Ejecutar backend: python app.py

# 4. CONFIGURACIÓN DE DESARROLLO:
#    - Copiar este archivo como .env
#    - Completar todas las variables marcadas como OBLIGATORIO
#    - Las variables OPCIONAL habilitan funcionalidades adicionales

# 5. VERIFICACIÓN:
#    - Ir a /health para verificar configuración
#    - Ir a /api/status para ver estado de APIs
#    - Ir a /docs para documentación completa

# ========================================
# NOTAS DE SEGURIDAD
# ========================================

# IMPORTANTE:
# - Nunca commitear el archivo .env al repositorio
# - Usar variables específicas para cada entorno
# - Rotar claves regularmente
# - Usar HTTPS en producción
# - Configurar CORS adecuadamente en el backend

# Para producción, usar servicios como:
# - Vercel/Netlify para frontend
# - Heroku/Railway para backend
# - Redis Cloud para Redis
# - Variables de entorno seguras del proveedor
